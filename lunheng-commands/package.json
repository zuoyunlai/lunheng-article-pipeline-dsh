    "SKILL.md",
    "README.md",
    "references/",
    "scripts/",
    "tests/"
  ],
  "scripts": {
    "test": "node --test tests/route.test.mjs",
    "route": "node scripts/route-command.mjs"
  },
  "keywords": [
    "dsh",
    "skill",
    "lunheng",
    "article-pipeline",
    "slash-command",
    "ai4scholar-inspired"
