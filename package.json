{
  "name": "lunheng-article-pipeline",
  "version": "18.2.0",
  "description": "论衡（lunheng-article-pipeline）— 多 Agent 深度长文流水线技能包（DeepSeek Harness 原生插件）：定题→并行检索（文献/数据/案例）→分析→大纲人在环确认→写作→批判→审计→审稿→修订→配图→终检交付，9 个独立角色 T1-T9 互不可替代（文献/数据/案例/分析/写作/批判/审计/终检/审稿），主控 = T0 调度 + T8 终检亲执行（T8 独立角色，执行者主控担任，不 spawn），T9 审稿可选默认选中学术必选，三角验证 + M 机械化硬门 + F 失败模式防御 + G14 中文 AI 痕迹闸 + 期刊匹配助手，用 dsh subagent 子代理编排。",
  "type": "module",
  "main": "lib/index.js",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "skill",
    "bundle",
    "article-pipeline",
    "agent",
    "论文流水线"
  ],
  "license": "MIT",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "author": "zuoyunlai",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zuoyunlai/lunheng-article-pipeline-dsh.git"
  },
  "homepage": "https://github.com/zuoyunlai/lunheng-article-pipeline-dsh#readme",
  "bugs": {
    "url": "https://github.com/zuoyunlai/lunheng-article-pipeline-dsh/issues"
  },
  "files": [
    "lib",
    "skills",
    "cordis.patch.yml",
    "LICENSE",
    "README.md",
    "SECURITY.md",
    "docs",
    "examples"
  ],
  "scripts": {
    "check:consistent": "node skills/lunheng-article-pipeline/scripts/consistency-check.mjs",
    "check:surface": "node scripts/plugin-surface-check.mjs",
    "check:hygiene": "node scripts/repo-hygiene-check.mjs",
    "check:pack-smoke": "node scripts/pack-smoke.mjs",
    "test": "node --test \"tests/**/*.test.mjs\""
  },
  "peerDependencies": {
    "@deepseek-ai/dsh": ">=0.1.2-rc.1 <0.2.0",
